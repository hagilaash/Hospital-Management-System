<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HMS Dashboard</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px;
            min-height: 100vh;

            background-image: url('/images/Hospital-Management-System.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        h1 {
            margin-bottom: 30px;
        }

        .topbar {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .logout-form {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 12px;
            background-color: rgba(255, 255, 255, 0.9);
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

        .logout-form button {
            padding: 8px 14px;
            border: none;
            border-radius: 4px;
            background: #1f4e79;
            color: white;
            font-size: 14px;
            cursor: pointer;
        }

        .logout-form button:hover {
            background: #163a5c;
        }

        .alert {
            margin-bottom: 20px;
            padding: 10px 12px;
            border-radius: 4px;
            font-size: 14px;
            max-width: 600px;
        }

        .alert-error {
            background: #fdecea;
            border: 1px solid #f5c2c0;
            color: #8a1f17;
        }

        .alert-success {
            background: #e8f5e9;
            border: 1px solid #b7dfb9;
            color: #1b5e20;
        }

        .modules {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .module {
            width: 200px;
            padding: 30px;
            background-color: rgba(255, 255, 255, 0.9);
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }
    </style>
</head>

<body>

    <div class="topbar">
        <h1>HMS Dashboard</h1>

        <form method="POST" action="{{ path('logout') }}" class="logout-form">
            <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
            <span>Signed in as <strong>{{ auth.username }}</strong></span>
            <button type="submit">Log out</button>
        </form>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-error" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="modules">

        {% for module in modules %}

    {% if module.module_name == 'Doctors' %}

        <a href="{{ path('doctors') }}" class="module">
            {{ module.module_name }}
        </a>

    {% elseif module.module_name == 'Patients' %}

        <a href="{{ path('patient_list') }}" class="module">
            {{ module.module_name }}
        </a>

    {% elseif module.module_name|lower == 'fdm' %}

        <a href="{{ path('fdm_dashboard') }}" class="module">
            {{ module.module_name }}
        </a>

    {% else %}

        <div class="module">
            {{ module.module_name }}
        </div>

    {% endif %}

{% endfor %}

    </div>

</body>
</html>
