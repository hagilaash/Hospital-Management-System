{# Frame for every RCM page: the shared shell plus the RCM sub-navigation, rcm.css and rcm.js. #}
{% extends 'layout/_layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/rcm.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/rcm.js" defer></script>
{% endblock %}

{% block content %}
    {% set current = app.request.attributes.get('_route') ?? '' %}

    <nav class="fdm-subnav no-print" aria-label="Revenue cycle management">
        {% for item in [
            {routes: ['rcm_index'], route: 'rcm_index', label: 'Overview'},
            {routes: ['rcm_pending', 'rcm_show'], route: 'rcm_pending', label: 'Pending queue'},
            {routes: ['rcm_completed'], route: 'rcm_completed', label: 'Completed'},
            {routes: ['rcm_dashboard'], route: 'rcm_dashboard', label: 'Dashboard'}
        ] %}
            {% if current in item.routes %}
                <a href="{{ path(item.route) }}" class="is-active" aria-current="page">{{ item.label }}</a>
            {% else %}
                <a href="{{ path(item.route) }}">{{ item.label }}</a>
            {% endif %}
        {% endfor %}
    </nav>

    {% block rcm_content %}{% endblock %}
{% endblock %}
