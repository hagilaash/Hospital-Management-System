<!DOCTYPE html>
<html>
<head>
    <title>HMS Dashboard</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px;
            min-height: 100vh;

            background-image: url('/images/Hospital-Management-System.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        h1 {
            margin-bottom: 30px;
        }

        .modules {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .module {
            width: 200px;
            padding: 30px;
            background-color: rgba(255, 255, 255, 0.9);
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }
    </style>
</head>

<body>

    <h1>HMS Dashboard</h1>

    <div class="modules">

        {% for module in modules %}

    {% if module.module_name == 'Doctors' %}

        <a href="{{ path('doctors') }}" class="module">
            {{ module.module_name }}
        </a>

    {% else %}

        <div class="module">
            {{ module.module_name }}
        </div>

    {% endif %}

{% endfor %}

    </div>

</body>
</html>