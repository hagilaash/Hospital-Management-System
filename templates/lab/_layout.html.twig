{# Frame for every Laboratory page: the shared shell plus the Laboratory sub-navigation, lab.css and lab.js. #}
{% extends 'layout/_layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/lab.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/lab.js" defer></script>
{% endblock %}

{% block content %}
    {% set current = app.request.attributes.get('_route') ?? '' %}

    <nav class="fdm-subnav no-print" aria-label="Laboratory">
        {% for item in [
            {routes: ['lab_dashboard'], route: 'lab_dashboard', label: 'Overview'},
            {routes: ['lab_worklist', 'lab_order_show', 'lab_report'], route: 'lab_worklist', label: 'Worklist'},
            {routes: ['lab_tests', 'lab_test_new', 'lab_test_edit'], route: 'lab_tests', label: 'Test catalogue'}
        ] %}
            {% if current in item.routes %}
                <a href="{{ path(item.route) }}" class="is-active" aria-current="page">{{ item.label }}</a>
            {% else %}
                <a href="{{ path(item.route) }}">{{ item.label }}</a>
            {% endif %}
        {% endfor %}
    </nav>

    {% block lab_content %}{% endblock %}
{% endblock %}
